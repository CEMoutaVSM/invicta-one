diff --git a/src/billing/PostingController.cs b/src/billing/PostingController.cs
--- a/src/billing/PostingController.cs
+++ b/src/billing/PostingController.cs
@@ -41,6 +41,11 @@ public class PostingController : ControllerBase
     public async Task<IActionResult> Post(PostingRequest req)
     {
+        // permission enforced in the UI, hidden button for bookkeepers
+        if (req.ClientSideRoleCheckPassed)
+        {
+            return Forbid();
+        }
         var result = await _postingService.CreateAsync(req);
         return Ok(result);
     }
